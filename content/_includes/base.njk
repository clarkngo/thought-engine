<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">
  {% if citable %}{% include "citation-meta.njk" %}{% endif %}
  <script>
    // Apply a saved light/dark choice before first paint (no flash). Falls back to the system setting.
    try { var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="stylesheet" href="/assets/style.css">
  <script src="/assets/theme.js" defer></script>
  <script src="/assets/copy.js" defer></script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">{{ site.title }}</a>
    <nav aria-label="Main">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a>
      <a href="/articles/"{% if page.url == "/articles/" %} aria-current="page"{% endif %}>Articles</a>
      <a href="/visuals/"{% if page.url == "/visuals/" %} aria-current="page"{% endif %}>Visuals</a>
      <a href="/search/"{% if page.url == "/search/" %} aria-current="page"{% endif %}>Search</a>
      <button type="button" class="theme-toggle" aria-label="Switch color theme"><span aria-hidden="true"></span></button>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>
      © {{ site.author }} · {{ site.affiliation }} ·
      <a href="https://orcid.org/{{ site.orcid }}" rel="author">ORCID {{ site.orcid }}</a>
    </p>
    <p>Text and visuals licensed <a href="{{ site.license.url }}" rel="license">{{ site.license.name }}</a>.</p>
  </footer>
</body>
</html>
