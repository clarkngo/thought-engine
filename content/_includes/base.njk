<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/assets/style.css">
  {%- block head %}{% endblock %}
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">{{ site.title }}</a>
    <nav aria-label="Main">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Posts</a>
      <a href="/visuals/"{% if page.url == "/visuals/" %} aria-current="page"{% endif %}>Visuals</a>
      <a href="/search/"{% if page.url == "/search/" %} aria-current="page"{% endif %}>Search</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="site-footer">© {{ site.author }}</footer>
</body>
</html>
