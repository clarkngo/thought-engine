---
layout: base.njk
---
{% from "visual.njk" import visual as renderVisual, searchImage %}
{%- set body = content | headingIds -%}
{%- set sections = content | toc -%}
<article class="article" data-pagefind-body>
  <span data-pagefind-filter="type:Article"></span>
  <header class="article-header">
    <p class="meta" data-pagefind-ignore>
      <span class="badge">Article</span>
      {% if pillar %}· <span data-pagefind-filter="pillar">{{ pillar }}</span>{% endif %}
      {% if draft %}· <span class="badge">Draft</span>{% endif %}
    </p>
    <h1>{{ title }}</h1>
    {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
    <p class="byline" data-pagefind-ignore>
      <a href="https://orcid.org/{{ site.orcid }}" rel="author">{{ site.author }}</a>
      · {{ site.affiliation }}
      · <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      · {{ content | readingMinutes }} min read
      {% if doi %}· <a href="https://doi.org/{{ doi }}">doi:{{ doi }}</a>{% endif %}
    </p>
  </header>

  {% if abstract %}
  <section class="abstract" aria-label="Abstract">
    <h2 class="abstract-label">Abstract</h2>
    <p>{{ abstract }}</p>
  </section>
  {% endif %}

  {% if visual %}
  {%- set item = { url: page.url, data: { visual: visual, visual_type: visual_type, poster: poster, alt: alt } } -%}
  <figure class="post-visual"{{ searchImage(item) | safe }}>
    {{ renderVisual(item, "full") | safe }}
    <figcaption>{{ alt }}{% if carousel %} · <a href="{{ carousel }}">Open the carousel (PDF)</a>{% endif %}</figcaption>
  </figure>
  {% endif %}

  {% if sections.length > 2 %}
  <nav class="toc" aria-label="Contents" data-pagefind-ignore>
    <h2 class="toc-label">Contents</h2>
    <ol>{% for s in sections %}<li><a href="#{{ s.id }}">{{ s.text }}</a></li>{% endfor %}</ol>
  </nav>
  {% endif %}

  <div class="prose">
    {{ body | safe }}
  </div>

  {% if related %}
  <section class="related" data-pagefind-ignore>
    <h2>Posts behind this article</h2>
    <ul>
      {% for p in collections.posts %}{% if (p.inputPath | folder) in related %}
      <li><a href="{{ p.url }}">{{ p.data.title }}</a> <span class="meta">· {{ p.date | readableDate }}</span></li>
      {% endif %}{% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if keywords %}
  <ul class="tags" aria-label="Keywords">
    {% for k in keywords %}<li data-pagefind-filter="keyword">{{ k }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% include "cite.njk" %}
</article>
