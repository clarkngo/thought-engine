---
layout: base.njk
---
{% from "visual.njk" import visual %}
{% macro card(item) %}
<a class="post-card" href="{{ item.url }}">
  {% if item.data.visual %}<div class="thumb">{{ visual(item) | safe }}</div>{% endif %}
  <div>
    <p class="meta">{% if item.data.kind == "Article" %}<span class="badge">Article</span> · {% endif %}{% set fl = { "quick-take": "Quick take", "practice": "From practice", "re-angle": "Revisited" } %}{% if fl[item.data.format] %}<span class="badge">{{ fl[item.data.format] }}</span> · {% endif %}<time datetime="{{ item.date | isoDate }}">{{ item.date | readableDate }}</time>{% if item.data.pillar %} · {{ item.data.pillar }}{% endif %}{% if item.data.draft %} · <span class="badge">Draft</span>{% endif %}</p>
    <h2>{{ item.data.title }}</h2>
    {% if item.data.description %}<p>{{ item.data.description }}</p>{% endif %}
  </div>
</a>
{% endmacro %}

<section class="intro">
  <h1>{{ site.title }}</h1>
  <p>{{ site.description }}</p>
  <p class="byline">{{ site.author }} · {{ site.affiliation }} · <a href="https://orcid.org/{{ site.orcid }}">ORCID</a></p>
</section>

{% if collections.articles.length %}
<section class="home-section">
  <h2 class="section-label">Latest article</h2>
  <ol class="post-list"><li>{{ card(collections.articles[0]) }}</li></ol>
</section>
{% endif %}

{% if collections.visuals.length %}
<section class="home-section">
  <div class="section-head">
    <h2 class="section-label">Visuals</h2>
    <a class="see-all" href="/visuals/">See all visuals →</a>
  </div>
  <ul class="visual-strip">
    {% for v in collections.visuals | head(6) %}
    <li><a href="{{ v.url }}" title="{{ v.data.title }}">{{ visual(v) | safe }}<span class="visually-hidden">{{ v.data.title }}</span></a></li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<section class="home-section">
  <h2 class="section-label">Posts</h2>
  {% if collections.posts.length %}
  <ol class="post-list">
    {% for post in collections.posts %}<li>{{ card(post) }}</li>{% endfor %}
  </ol>
  {% else %}
  <p class="empty">No posts yet.</p>
  {% endif %}
</section>
